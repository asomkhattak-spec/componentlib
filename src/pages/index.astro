---
import Base from '../layouts/Base.astro';
import { components, categories, categoryLabel } from '../lib/registry';
---

<Base title="componentlib — copy-paste UI components">
  <section class="hero">
    <h1>Components you can paste and ship</h1>
    <p>
      Browse live previews, grab the HTML, CSS and JavaScript — or switch to the
      React or Vue variant. Every snippet is self-contained.
    </p>
  </section>

  <section id="gallery" aria-label="Component gallery">
    <div class="gallery-controls">
      <input
        type="search"
        class="search-input"
        id="gallery-search"
        placeholder="Search components…"
        aria-label="Search components"
      />
      <div class="chip-row" role="group" aria-label="Filter by category">
        <button type="button" class="chip" data-category="all" aria-pressed="true">All</button>
        {categories.map((cat) => (
          <button type="button" class="chip" data-category={cat} aria-pressed="false">
            {categoryLabel(cat)}
          </button>
        ))}
      </div>
    </div>

    <div class="gallery-grid" id="gallery-grid">
      {components.map((c) => (
        <article
          class="component-card"
          data-id={c.id}
          data-category={c.category}
          data-title={c.title.toLowerCase()}
          data-tags={c.tags.join(' ').toLowerCase()}
          data-description={c.description.toLowerCase()}
        >
          <iframe
            class="card-preview"
            data-component={c.id}
            title={`Preview of ${c.title}`}
            loading="lazy"
            tabindex="-1"
            aria-hidden="true"
          ></iframe>
          <div class="card-body">
            <h2><a href={`/components/${c.category}/${c.slug}/`}>{c.title}</a></h2>
            <p>{c.description}</p>
            <div class="card-meta">
              <div class="tag-row">
                {c.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
              </div>
              <div class="variant-badges">
                {Object.keys(c.variants).map((v) => <span>{v === 'vanilla' ? 'HTML' : v}</span>)}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="no-results" id="no-results" hidden>No components match your search.</p>
  </section>
</Base>

<script>
  import Fuse from 'fuse.js';
  import { mountPreview, rethemePreview, type PreviewSpec } from '../lib/preview';

  interface RegistryEntry {
    id: string;
    title: string;
    description: string;
    tags: string[];
    category: string;
    preview: { background: 'light' | 'dark' | 'auto'; height: number };
    variants: Record<string, { files?: Record<string, string>; bundle?: string; css?: string }>;
  }

  const res = await fetch('/registry.json');
  const registry: { components: RegistryEntry[] } = await res.json();
  const byId = new Map(registry.components.map((c) => [c.id, c]));

  function specFor(entry: RegistryEntry): PreviewSpec {
    const v = entry.variants.vanilla;
    return {
      kind: 'vanilla',
      html: v.files?.html,
      css: v.files?.css,
      js: v.files?.js,
      background: entry.preview.background,
      height: 170,
      interactive: false,
    };
  }

  // Mount thumbnails lazily as cards scroll into view.
  const specs = new Map<HTMLIFrameElement, PreviewSpec>();
  const io = new IntersectionObserver((observations) => {
    for (const o of observations) {
      if (!o.isIntersecting) continue;
      const frame = o.target as HTMLIFrameElement;
      const spec = specs.get(frame);
      if (spec && !frame.srcdoc) mountPreview(frame, spec);
      io.unobserve(frame);
    }
  }, { rootMargin: '200px' });

  document.querySelectorAll<HTMLIFrameElement>('.card-preview').forEach((frame) => {
    const entry = byId.get(frame.dataset.component!);
    if (!entry) return;
    const spec = specFor(entry);
    specs.set(frame, spec);
    io.observe(frame);
  });

  // Keep thumbnails in sync with the site theme toggle.
  new MutationObserver(() => {
    specs.forEach((spec, frame) => {
      if (frame.srcdoc) rethemePreview(frame, spec);
    });
  }).observe(document.querySelector('meta[name="color-scheme"]')!, {
    attributes: true,
    attributeFilter: ['content'],
  });

  // Search + category filter.
  const cards = [...document.querySelectorAll<HTMLElement>('.component-card')];
  const fuse = new Fuse(registry.components, {
    keys: ['title', 'description', 'tags'],
    threshold: 0.35,
    ignoreLocation: true,
  });
  const search = document.getElementById('gallery-search') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const noResults = document.getElementById('no-results')!;
  let category = 'all';

  function apply() {
    const query = search.value.trim();
    const matches = query ? new Set(fuse.search(query).map((r) => r.item.id)) : null;
    let visible = 0;
    for (const card of cards) {
      const okCategory = category === 'all' || card.dataset.category === category;
      const okQuery = !matches || matches.has(card.dataset.id!);
      const show = okCategory && okQuery;
      card.hidden = !show;
      if (show) visible++;
    }
    noResults.hidden = visible > 0;
  }

  search.addEventListener('input', apply);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      category = chip.dataset.category!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    }),
  );

  // Deep link: /?category=loaders preselects a category chip.
  const initial = new URLSearchParams(location.search).get('category');
  if (initial) {
    const chip = chips.find((c) => c.dataset.category === initial);
    if (chip) chip.click();
  }
</script>
