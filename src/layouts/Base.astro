---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Copy-paste HTML, CSS and JavaScript components with live previews. Vanilla, React and Vue variants.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // FOUC prevention only: apply the stored scheme override before paint.
      try {
        document.querySelector('meta[name="color-scheme"]').content =
          localStorage.getItem('color-scheme') ?? 'light dark';
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-logo" href="/">component<span>lib</span></a>
        <nav aria-label="Site">
          <a href="/#gallery">Components</a>
          <a href="/contribute">Contribute</a>
          <button type="button" class="theme-toggle" id="theme-toggle">
            <svg class="icon-to-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
            </svg>
            <svg class="icon-to-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <span class="visually-hidden label-to-dark">Switch to dark theme</span>
            <span class="visually-hidden label-to-light">Switch to light theme</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        componentlib — open component snippets. Vanilla HTML/CSS/JS, React and Vue.
      </div>
    </footer>

    <script>
      // Theme toggle: two-state control over a tri-state model
      // (system / light / dark). Toggling targets the opposite of the
      // currently RENDERED scheme; a target matching the system preference
      // removes the stored override instead of pinning it. Icon and label
      // visibility is handled entirely in CSS, so no-JS stays correct.
      const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
      const toggle = document.getElementById('theme-toggle')!;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');

      function renderedDark(): boolean {
        if (meta.content === 'dark') return true;
        if (meta.content === 'light') return false;
        return systemDark.matches;
      }

      function broadcast(scheme: string) {
        // Notify preview frames so they follow the page scheme (Safari
        // resolves prefers-color-scheme to the OS inside iframes).
        document.querySelectorAll<HTMLIFrameElement>('iframe[data-themed]').forEach((f) => {
          f.contentWindow?.postMessage({ type: 'preview-theme', scheme }, '*');
        });
      }

      toggle.addEventListener('click', () => {
        const target = renderedDark() ? 'light' : 'dark';
        const targetMatchesSystem = target === (systemDark.matches ? 'dark' : 'light');
        try {
          if (targetMatchesSystem) localStorage.removeItem('color-scheme');
          else localStorage.setItem('color-scheme', target);
        } catch {}
        meta.content = targetMatchesSystem ? 'light dark' : target;
        broadcast(target);
      });

      window.addEventListener('storage', (e) => {
        if (e.key === 'color-scheme') {
          meta.content = e.newValue ?? 'light dark';
          broadcast(renderedDark() ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>
